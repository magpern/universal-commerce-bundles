{
    "name": "magpern/universal-commerce-bundles",
    "description": "A generic WooCommerce plugin for fixed product kits — simple, statically-priced \"bundle\" products composed of a fixed set of components, sold as one SKU, picked to order.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "magpern"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcsstandards/phpcsutils": "^1.0",
        "phpcsstandards/phpcsextra": "^1.2",
        "woocommerce/woocommerce-sniffs": "^1.0",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "php-stubs/woocommerce-stubs": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "UniversalCommerceBundles\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UniversalCommerceBundles\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "stan": "phpstan analyse --memory-limit=1G",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ],
        "package": "bash bin/build-zip.sh"
    }
}
